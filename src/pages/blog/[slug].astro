---
import { getImage } from "astro:assets";
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogPost from "../../components/BlogPost.astro";
import { BLOG_IMAGE_WIDTH, IMAGE_QUALITY } from "../../lib/imageOptimization";

const { slug } = Astro.params;

const notFound = () =>
    new Response(null, { status: 404, statusText: "Not Found" });

if (!slug) {
    return notFound();
}

const post = await getEntry("blogs", slug);

if (!post || (post.data.draft && !import.meta.env.DEV)) {
    return notFound();
}

const { Content } = await render(post);
const locale = Astro.locals.locale;

const banner = post.data.hoverImage
    ? await getImage({
          src: post.data.hoverImage,
          width: BLOG_IMAGE_WIDTH,
          quality: IMAGE_QUALITY,
      })
    : undefined;
---

<Layout blogBanner={Boolean(banner)} bannerPreload={banner?.src}>
    <main id="main-content">
        <div transition:animate="fade">
            <BlogPost post={post} locale={locale} banner={banner}>
                <Content />
            </BlogPost>
        </div>
    </main>
</Layout>

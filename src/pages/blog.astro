---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogsTitle from "../components/BlogsTitle.astro";
import BlogCard from "../components/BlogCard.astro";
import { getTranslations } from "../i18n";

const locale = Astro.locals.locale;
const t = getTranslations(locale);
const isDev = import.meta.env.DEV;

const posts = (await getCollection("blogs"))
    .filter((post) => isDev || !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const indexedPosts = posts.map((post, index) => ({ post, index }));

const yearGroups: { year: number; items: typeof indexedPosts }[] = [];
for (const item of indexedPosts) {
    const year = item.post.data.pubDate.getFullYear();
    const last = yearGroups.at(-1);
    if (last?.year === year) {
        last.items.push(item);
    } else {
        yearGroups.push({ year, items: [item] });
    }
}
---

<Layout>
    <main id="main-content">
        <div transition:animate="fade">
            <BlogsTitle />
            <section
                class="w-full max-w-4xl mx-auto px-6 py-8 md:py-12"
                aria-label={t.blog.heading}
            >
                {
                    posts.length === 0 ? (
                        <p class="text-bio text-center md:text-left">
                            {t.blog.empty}
                        </p>
                    ) : (
                        <div class="flex flex-col gap-10">
                            {yearGroups.map((group) => (
                                <div class="blog-index-group">
                                    <h2 class="blog-index-year font-mono text-sm text-muted tracking-[0.18em]">
                                        {group.year}
                                    </h2>
                                    <div
                                        class="blog-index-rule"
                                        aria-hidden="true"
                                    />
                                    <div class="blog-index-posts min-w-0 overflow-visible">
                                        {group.items.map(({ post, index }) => (
                                            <BlogCard
                                                slug={post.id}
                                                title={post.data.title}
                                                description={
                                                    post.data.description
                                                }
                                                pubDate={post.data.pubDate}
                                                tags={post.data.tags}
                                                hoverImage={post.data.hoverImage}
                                                locale={locale}
                                                index={index}
                                            />
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )
                }
            </section>
        </div>
    </main>
</Layout>

<style>
    .blog-index-group {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .blog-index-year {
        margin: 0;
    }

    .blog-index-rule {
        display: none;
        width: 1px;
        background: var(--color-surface-border);
    }

    @media (min-width: 768px) {
        .blog-index-group {
            grid-template-columns: 3.5rem 1px 1fr;
            gap: 0 1.25rem;
            align-items: stretch;
        }

        .blog-index-year {
            position: sticky;
            top: calc(var(--site-header-offset) + 1rem);
            align-self: start;
        }

        .blog-index-rule {
            display: block;
        }
    }
</style>

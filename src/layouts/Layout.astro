---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { getTranslations } from "../i18n";
import "../styles/global.css";
import "@fontsource-variable/plus-jakarta-sans";

const locale = Astro.locals.locale;
const t = getTranslations(locale);

const pageBackground = "background-color:#000;color-scheme:dark";
---

<!doctype html>
<html lang={locale} style={pageBackground}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        <Analytics />
        <title>{t.meta.title}</title>
    </head>
    <body style="margin:0;color:#fff">
        <a href="#main-content" class="skip-link focus-ring">{t.a11y.skipToContent}</a>
        <div class="relative z-10">
            <Navbar />
            <slot />
            <Footer />
        </div>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        font-family: "plus-jakarta-sans";
    }

    html {
        height: auto;
    }

    body {
        min-height: 100vh;
    }
</style>

<script define:vars={{ locale }}>
    import { locale as localeStore } from "../i18n/locale";
    localeStore.set(locale);
</script>

---
import Background from "../components/Background.astro";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import { getTranslations } from "../i18n";
import pcHeroCover from "../assets/pc-hero-cover-generated.jpg";
import "../styles/global.css";
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/cormorant";

interface Props {
    homeScreen?: boolean;
}

const { homeScreen = false } = Astro.props;
const locale = Astro.locals.locale;
const t = getTranslations(locale);

const pageBackground = "background-color:#000;color-scheme:dark";
---

<!doctype html>
<html lang={locale} style={pageBackground}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        <Analytics />
        <title>{t.meta.title}</title>
    </head>
    <body
        class:list={[{ "is-home-screen": homeScreen }]}
        style="margin:0;color:#fff"
    >
        <a href="#main-content" class="skip-link focus-ring">{t.a11y.skipToContent}</a>
        <div
            id="home-screen-bg"
            class="home-screen-bg"
            aria-hidden="true"
            hidden={!homeScreen}
        >
            <img
                class="home-screen-bg__img"
                src={pcHeroCover.src}
                alt=""
                width={pcHeroCover.width}
                height={pcHeroCover.height}
                decoding="async"
                fetchpriority="high"
                draggable="false"
            />
            <div class="home-screen-bg__veil"></div>
        </div>
        <div id="site-work-background" hidden={homeScreen}>
            <Background mode="work" />
        </div>
        <div class="relative z-10">
            <Navbar />
            <div
                id="site-page-body"
                class:list={[{ "home-page-body": homeScreen }]}
            >
                <slot />
            </div>
            <div id="site-footer">
                <Footer />
            </div>
        </div>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        font-family: "plus-jakarta-sans";
    }

    html {
        height: auto;
    }

    body {
        min-height: 100vh;
        background-color: #000;
    }
</style>

<script>
    function normalizePath(pathname: string) {
        const path = pathname.replace(/\/$/, "");
        return path || "/";
    }

    function isHomePath(pathname: string) {
        return normalizePath(pathname) === "/home";
    }

    function syncRouteLayout() {
        const isHome = isHomePath(window.location.pathname);

        document.body.classList.toggle("is-home-screen", isHome);

        document.getElementById("site-page-body")?.classList.toggle("home-page-body", isHome);

        const homeBg = document.getElementById("home-screen-bg");
        if (homeBg) homeBg.hidden = !isHome;

        const workBg = document.getElementById("site-work-background");
        if (workBg) workBg.hidden = isHome;

        const footer = document.getElementById("site-footer");
        if (footer) {
            footer.hidden = isHome && window.matchMedia("(max-width: 1279px)").matches;
        }

        if (!isHome) {
            document.documentElement.style.removeProperty("overflow");
            document.documentElement.style.removeProperty("height");
            document.documentElement.style.removeProperty("overscroll-behavior");
            document.body.style.removeProperty("overflow");
            document.body.style.removeProperty("height");
            document.body.style.removeProperty("overscroll-behavior");
        }
    }

    syncRouteLayout();
    document.addEventListener("astro:page-load", syncRouteLayout);
    document.addEventListener("astro:after-swap", syncRouteLayout);
    window.matchMedia("(max-width: 1279px)").addEventListener("change", syncRouteLayout);
</script>

<script define:vars={{ locale }}>
    import { locale as localeStore } from "../i18n/locale";
    localeStore.set(locale);
</script>

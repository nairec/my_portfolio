---
import { getTranslations } from "../i18n";
import CategoryFilter from "./CategoryFilter.astro";

const t = getTranslations(Astro.locals.locale);
---

<div class="flex flex-col gap-6 items-center mt-10 w-full max-w-4xl mx-auto text-center px-[clamp(1rem,4vw,1.5rem)]">
    <h1 class="font-mono text-2xl md:text-3xl text-white">
        <span class="text-accent">02.</span>
        <span class="text-indigo-400">{t.projects.title}</span>
    </h1>
    <CategoryFilter
        labels={t.projects.categories}
        ariaLabel={t.a11y.categoryFilter}
    />
</div>

---
import { getTranslations } from "../i18n";
import CategoryFilter from "./CategoryFilter.astro";

const t = getTranslations(Astro.locals.locale);
---

<div class="flex flex-col gap-6 items-center md:items-start mt-10 w-full max-w-5xl mx-auto px-6 text-center md:text-left">
    <h1 class="projects-enter projects-enter--title text-5xl text-muted tracking-tight">
        {t.projects.title}
    </h1>
    <div class="projects-enter projects-enter--filter w-full">
        <CategoryFilter
            labels={t.projects.categories}
            ariaLabel={t.a11y.categoryFilter}
        />
    </div>
</div>

<style>
    @keyframes projects-fade-up {
        from {
            opacity: 0;
            transform: translateY(1.25rem);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .projects-enter {
        opacity: 0;
        animation: projects-fade-up 700ms var(--ease-out-smooth) forwards;
    }

    .projects-enter--title {
        animation-delay: 80ms;
    }

    .projects-enter--filter {
        animation-delay: 180ms;
    }

    @media (prefers-reduced-motion: reduce) {
        .projects-enter {
            opacity: 1;
            animation: none;
            transform: none;
        }
    }
</style>

---
import { getTranslations } from "../i18n";
import CategoryFilter from "./CategoryFilter.astro";

const t = getTranslations(Astro.locals.locale);
---

<div class="flex flex-col gap-6 items-center md:items-start mt-10 w-full max-w-5xl mx-auto px-6 text-center md:text-left">
    <h1 class="text-5xl text-muted tracking-tight">
        {t.projects.title}
    </h1>
    <CategoryFilter
        labels={t.projects.categories}
        ariaLabel={t.a11y.categoryFilter}
    />
</div>

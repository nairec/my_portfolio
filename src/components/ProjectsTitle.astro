---
import { getTranslations } from "../i18n";
import ModeToggle from "./ModeToggle.astro";

const t = getTranslations(Astro.locals.locale);
---

<div class="flex flex-col gap-6 items-center mt-10 w-full text-center px-6">
    <h1 class="font-mono text-2xl md:text-3xl text-white">
        <span class="text-accent">02.</span>
        <span
            id="projectsSpan"
            class="text-indigo-400 transition-colors duration-300"
            data-title-serious={t.projects.titleSerious}
            data-title-fun={t.projects.titleFun}
        >
            {t.projects.titleSerious}
        </span>
    </h1>
    <ModeToggle
        modeSerious={t.projects.modeSerious}
        modeFun={t.projects.modeFun}
    />
</div>

<script>
    import { mode } from "../projects.js";

    document.addEventListener("astro:page-load", () => {
        const projectsSpan = document.getElementById("projectsSpan");
        if (!projectsSpan) return;

        const titleSerious =
            projectsSpan.dataset.titleSerious ?? "serious projects";
        const titleFun = projectsSpan.dataset.titleFun ?? "fun projects";

        function updateTitle(value: string) {
            if (value === "fun") {
                projectsSpan.textContent = titleFun;
                projectsSpan.classList.remove("text-indigo-400");
                projectsSpan.classList.add("text-cyan-300");
            } else {
                projectsSpan.textContent = titleSerious;
                projectsSpan.classList.remove("text-cyan-300");
                projectsSpan.classList.add("text-indigo-400");
            }
        }

        mode.subscribe(updateTitle);
        updateTitle(mode.get());
    });
</script>

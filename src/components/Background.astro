---
const { mode } = Astro.props;

const palette =
    mode === "work"
        ? {
              primary: "blue-900/40",
              secondary: "indigo-900/40",
              accent: "slate-900/90",
          }
        : {
              primary: "fuchsia-900/40",
              secondary: "purple-900/40",
              accent: "slate-900/90",
          };
---

<div
    class="pointer-events-none fixed inset-0 z-0 h-full w-full"
    transition:persist="site-background"
    aria-hidden="true"
>
    <div
        class="absolute inset-0 h-full w-full bg-[radial-gradient(ellipse_at_bottom_left,#0891b2,transparent)] opacity-15"
    >
    </div>
</div>

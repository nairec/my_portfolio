---
import { ALL_CATEGORY, PROJECT_CATEGORIES } from "../projects.js";

export interface Props {
    labels: Record<string, string>;
    ariaLabel: string;
}

const { labels, ariaLabel } = Astro.props;
const filterOptions = [ALL_CATEGORY, ...PROJECT_CATEGORIES];
---

<div class="category-filter-wrapper">
    <div class="category-filter-scroll">
        <div
            id="category-filter"
            class="font-mono uppercase text-white"
            role="group"
            aria-label={ariaLabel}
        >
            {
                filterOptions.map((category, index) => (
                    <>
                        {index > 0 && (
                            <span
                                class="category-filter-separator"
                                aria-hidden="true"
                            >
                                /
                            </span>
                        )}
                        <button
                            type="button"
                            class:list={[
                                "category-btn interactive-base hover:opacity-100 cursor-pointer focus-ring active:scale-95",
                                category === ALL_CATEGORY
                                    ? "is-active"
                                    : "opacity-50",
                            ]}
                            data-category={category}
                            aria-pressed={category === ALL_CATEGORY ? "true" : "false"}
                        >
                            {labels[category]}
                        </button>
                    </>
                ))
            }
        </div>
    </div>

    <span
        id="category-indicator"
        class="category-indicator"
        aria-hidden="true"
    ></span>
</div>

<style>
    .category-filter-wrapper {
        position: relative;
        width: 100%;
        margin-block: clamp(1.5rem, 4vw, 2rem);
    }

    .category-filter-scroll {
        display: flex;
        justify-content: center;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        padding-inline: clamp(0.25rem, 2vw, 0.75rem);
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .category-filter-scroll::-webkit-scrollbar {
        display: none;
    }

    #category-filter {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: center;
        width: max-content;
        max-width: 100%;
        padding-bottom: clamp(0.2rem, 0.6vw, 0.35rem);
        white-space: nowrap;
        font-size: clamp(0.65rem, 2.2vw + 0.2rem, 0.875rem);
        letter-spacing: clamp(0.04em, 0.35vw, 0.1em);
        gap: clamp(0.375rem, 2.2vw, 1.5rem);
    }

    .category-filter-separator {
        flex-shrink: 0;
        opacity: 0.2;
        pointer-events: none;
    }

    .category-btn {
        flex-shrink: 0;
        white-space: nowrap;
        padding-bottom: clamp(0.15rem, 0.4vw, 0.25rem);
    }

    .category-btn.is-active {
        color: rgb(129 140 248);
        opacity: 1;
    }

    .category-indicator {
        position: absolute;
        bottom: 0;
        left: 0;
        height: clamp(1.5px, 0.15vw, 2.5px);
        border-radius: 9999px;
        pointer-events: none;
        background-color: rgb(129 140 248);
        transition:
            transform var(--duration-base) var(--ease-out-smooth),
            width var(--duration-base) var(--ease-out-smooth),
            background-color var(--duration-base) var(--ease-out-smooth);
    }

    @media (prefers-reduced-motion: reduce) {
        .category-indicator {
            transition: background-color var(--duration-base) var(--ease-out-smooth);
        }
    }
</style>

<script>
    import {
        ALL_CATEGORY,
        categoryFilter,
    } from "../projects.js";

    document.addEventListener("astro:page-load", () => {
        const wrapper = document.querySelector(".category-filter-wrapper");
        const scrollContainer = document.querySelector(".category-filter-scroll");
        const container = document.getElementById("category-filter");
        const indicator = document.getElementById("category-indicator");
        const buttons = Array.from(
            container?.querySelectorAll<HTMLButtonElement>(".category-btn") ?? [],
        );

        let skipTransition = true;

        function moveIndicator(activeBtn: HTMLButtonElement) {
            if (!wrapper || !indicator) return;

            const wrapperRect = wrapper.getBoundingClientRect();
            const btnRect = activeBtn.getBoundingClientRect();

            if (skipTransition) {
                indicator.style.transition = "none";
            }

            indicator.style.width = `${btnRect.width}px`;
            indicator.style.transform = `translateX(${btnRect.left - wrapperRect.left}px)`;

            if (skipTransition) {
                requestAnimationFrame(() => {
                    indicator.style.transition = "";
                    skipTransition = false;
                });
            }
        }

        function setActive(btn: HTMLButtonElement) {
            btn.classList.add("is-active");
            btn.classList.remove("opacity-50");
            btn.setAttribute("aria-pressed", "true");
        }

        function setInactive(btn: HTMLButtonElement) {
            btn.classList.remove("is-active");
            btn.classList.add("opacity-50");
            btn.setAttribute("aria-pressed", "false");
        }

        function updateUI(currentFilter: string) {
            buttons.forEach((btn) => {
                const isActive = btn.dataset.category === currentFilter;
                if (isActive) {
                    setActive(btn);
                    moveIndicator(btn);
                } else {
                    setInactive(btn);
                }
            });
        }

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const category = btn.dataset.category ?? ALL_CATEGORY;
                categoryFilter.set(category);
                updateUI(category);
            });
        });

        updateUI(categoryFilter.get());

        window.addEventListener("resize", () => updateUI(categoryFilter.get()));
        scrollContainer?.addEventListener("scroll", () =>
            updateUI(categoryFilter.get()),
        );
    });
</script>

---
import { getTranslations } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { pathname } = Astro.url;
const locale = Astro.locals.locale;
const t = getTranslations(locale);

const navItems = [
    { name: t.nav.home, href: "/" },
    { name: t.nav.projects, href: "/projects" },
    { name: t.nav.blog, href: "/blog" },
];

const isActive = (href: string) => {
    const currentPath = pathname.replace(/\/$/, "");
    const targetPath = href.replace(/\/$/, "");
    return currentPath === targetPath;
};
---

<header>
    <nav
        class="flex flex-row flex-wrap gap-5 md:pr-10 items-center font-mono justify-end text-white p-5 w-full"
        aria-label={t.nav.ariaLabel}
    >
        {
            navItems.map((item, i) => (
                <a
                    href={item.href}
                    class:list={[
                        "interactive-base focus-ring pb-0.5",
                        isActive(item.href)
                            ? "text-cyan-300 border-b border-cyan-400/60"
                            : "text-white border-b border-transparent hover:text-cyan-300",
                    ]}
                >
                    <span class="text-accent">
                        {String(i + 1).padStart(2, "0")}.{" "}
                    </span>
                    {item.name}
                </a>
            ))
        }
        <LanguageSwitcher />
    </nav>
</header>

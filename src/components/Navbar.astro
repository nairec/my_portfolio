---
import { getTranslations } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { pathname } = Astro.url;
const locale = Astro.locals.locale;
const t = getTranslations(locale);

const navItems = [
    { name: t.nav.home, href: "/home" },
    { name: t.nav.specialties, href: "/especialidades" },
    { name: t.nav.projects, href: "/proyectos" },
    { name: t.nav.blog, href: "/blog" },
];

const isActive = (href: string) => {
    const currentPath = pathname.replace(/\/$/, "");
    const targetPath = href.replace(/\/$/, "");
    return currentPath === targetPath;
};
---

<header
    class="site-header sticky top-0 z-50 w-full border-b border-gray-800/60 bg-black/25 backdrop-blur-md"
>
    <nav
        class="site-nav flex flex-row flex-nowrap items-center font-mono justify-end text-white w-full gap-2 px-3 py-2.5 sm:gap-3 sm:px-4 sm:py-3 md:gap-5 md:p-5 md:pr-10"
        aria-label={t.nav.ariaLabel}
    >
        {
            navItems.map((item, i) => (
                <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                        "site-nav__link interactive-base focus-ring shrink-0 pb-0.5",
                        isActive(item.href)
                            ? "text-cyan-300 border-b border-cyan-400/60"
                            : "text-white border-b border-transparent hover:text-cyan-300",
                    ]}
                >
                    <span class="site-nav__index text-accent">
                        {String(i + 1).padStart(2, "0")}.{" "}
                    </span>
                    {item.name}
                </a>
            ))
        }
        <LanguageSwitcher class="shrink-0" />
    </nav>
</header>

<style>
    .site-nav {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .site-nav::-webkit-scrollbar {
        display: none;
    }

    .site-nav__link {
        font-size: 0.68rem;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .site-nav__index {
        display: none;
    }

    @media (min-width: 380px) {
        .site-nav__link {
            font-size: 0.72rem;
        }

        .site-nav__index {
            display: inline;
        }
    }

    @media (min-width: 640px) {
        .site-nav__link {
            font-size: 0.8rem;
        }
    }

    @media (min-width: 768px) {
        .site-nav {
            overflow-x: visible;
        }

        .site-nav__link {
            font-size: 1rem;
            letter-spacing: 0;
        }
    }
</style>

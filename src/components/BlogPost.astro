---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";

interface Props {
    post: CollectionEntry<"blogs">;
    locale: Locale;
}

const { post, locale } = Astro.props;
const t = getTranslations(locale);
const { title, description, pubDate, updatedDate, tags } = post.data;

const dateOpts: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
};

const formattedPub = pubDate.toLocaleDateString(locale, dateOpts);
const formattedUpdated = updatedDate?.toLocaleDateString(locale, dateOpts);
---

<article class="w-full max-w-3xl mx-auto px-6 py-10">
    <a
        href="/blog"
        class="interactive-base focus-ring text-sm text-muted hover:text-accent font-mono"
    >
        ← {t.blog.backToList}
    </a>

    <header class="mt-8">
        <p class="text-sm text-muted font-mono">
            <span class="sr-only">{t.blog.publishedOn} </span>
            <time datetime={pubDate.toISOString()}>{formattedPub}</time>
            {
                formattedUpdated && (
                    <>
                        <span aria-hidden="true"> · </span>
                        <span>
                            {t.blog.updatedOn}{" "}
                            <time datetime={updatedDate!.toISOString()}>
                                {formattedUpdated}
                            </time>
                        </span>
                    </>
                )
            }
        </p>
        <h1 class="mt-3 text-4xl md:text-5xl tracking-tight text-white">
            {title}
        </h1>
        <p class="mt-4 text-lg text-bio leading-relaxed">
            {description}
        </p>
        {
            tags.length > 0 && (
                <ul
                    class="mt-6 flex flex-wrap gap-2"
                    aria-label={t.blog.tagsLabel}
                >
                    {tags.map((tag) => (
                        <li class="text-xs font-mono text-muted border border-surface-border/50 px-2 py-1">
                            {tag}
                        </li>
                    ))}
                </ul>
            )
        }
    </header>

    <div class="blog-content mt-10">
        <slot />
    </div>
</article>

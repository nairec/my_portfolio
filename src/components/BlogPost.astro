---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { getTranslations } from "../i18n";

interface Props {
    post: CollectionEntry<"blogs">;
    locale: Locale;
}

const { post, locale } = Astro.props;
const t = getTranslations(locale);
const { title, description, pubDate, updatedDate, tags, compactImages, hoverImage } =
    post.data;

const dateOpts: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
};

const formattedPub = pubDate.toLocaleDateString(locale, dateOpts);
const formattedUpdated = updatedDate?.toLocaleDateString(locale, dateOpts);

const banner = hoverImage
    ? await getImage({ src: hoverImage, width: 2400 })
    : undefined;
---

<div class:list={["blog-post-shell", banner && "blog-post-shell--banner"]}>
    {
        banner && (
            <div
                class="blog-post-banner"
                id="blog-post-banner"
                aria-hidden="true"
            >
                <img
                    class="blog-post-banner__img"
                    src={banner.src}
                    alt=""
                    width={banner.attributes.width}
                    height={banner.attributes.height}
                />
            </div>
        )
    }

    <article
        class:list={[
            "w-full max-w-3xl mx-auto px-6 py-10",
            compactImages && "blog-post--compact-images",
        ]}
    >
        <a
            href="/blog"
            class="interactive-base focus-ring text-sm text-muted hover:text-accent font-mono tracking-wide"
        >
            ← {t.blog.backToList}
        </a>

        <header class="mt-8">
            <p class="text-sm text-muted font-mono">
                <span class="sr-only">{t.blog.publishedOn} </span>
                <time datetime={pubDate.toISOString()}>{formattedPub}</time>
                {
                    formattedUpdated && (
                        <>
                            <span aria-hidden="true"> · </span>
                            <span>
                                {t.blog.updatedOn}{" "}
                                <time datetime={updatedDate!.toISOString()}>
                                    {formattedUpdated}
                                </time>
                            </span>
                        </>
                    )
                }
            </p>
            <h1
                class="blog-post-title mt-3 text-4xl md:text-5xl tracking-tight text-ink"
            >
                {title}
            </h1>
            <p class="mt-4 text-lg text-bio leading-relaxed">
                {description}
            </p>
            {
                tags.length > 0 && (
                    <ul
                        class="mt-6 flex flex-wrap gap-2"
                        aria-label={t.blog.tagsLabel}
                    >
                        {tags.map((tag) => (
                            <li class="text-xs font-mono text-muted border border-surface-border px-2 py-1">
                                {tag}
                            </li>
                        ))}
                    </ul>
                )
            }
        </header>

        <div class="blog-content mt-10 pt-8 border-t border-surface-border">
            <slot />
        </div>
    </article>
</div>

<style>
    .blog-post-title {
        font-family: "Cormorant Variable", "Times New Roman", serif;
        font-weight: 500;
    }

    .blog-post-banner {
        position: relative;
        width: 100%;
        height: min(52vh, 28rem);
        overflow: hidden;
        view-transition-name: none;
    }

    .blog-post-banner__img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: none;
        margin: 0;
        border: 0;
        object-fit: cover;
        object-position: center 42%;
    }

    .blog-post-banner::after {
        content: "";
        position: absolute;
        inset: auto 0 0;
        height: 6rem;
        background: linear-gradient(
            transparent,
            var(--blog-bg, #1a1917)
        );
        pointer-events: none;
    }
</style>

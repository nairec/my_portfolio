---
import Tag from "./Tag.astro";
import Chatbot from "./Chatbot.tsx";
import SectionDivider from "./SectionDivider.astro";
import { getTranslations } from "../i18n";
import webDevIllustration from "../assets/SVGs/web-developer.svg?raw";
import aiIllustration from "../assets/SVGs/artificial-intelligence.svg?raw";
import automationIllustration from "../assets/SVGs/task-automation.svg?raw";
import cloudIllustration from "../assets/SVGs/cloud-dev.svg?raw";

const locale = Astro.locals.locale;
const t = getTranslations(locale);

const workIllustrations = [
    webDevIllustration,
    aiIllustration,
    automationIllustration,
    cloudIllustration,
];
---

<div id="container">
    <main id="main-content">
        <div
            class="hero-layout flex flex-row gap-16 xl:gap-20 mt-0 xl:mt-15 min-h-100vh align-center justify-between max-w-7xl mx-auto w-full px-0 xl:px-6"
        >
            <section id="hero" class="hero">
                <aside class="hero-portada__band" aria-hidden="true">
                    <img
                        src="/images/hero-cover-portada.png"
                        alt=""
                        width="1024"
                        height="1536"
                        decoding="async"
                        fetchpriority="high"
                    />
                </aside>
                <div class="hero-portada__panel">
                    <div class="hero-portada__copy">
                        <p class="hero-greeting hero-portada__desktop-only">
                            {t.hero.greeting}
                        </p>
                        <h1 class="hero-name">{t.hero.name}</h1>
                        <h2 class="title hero-tagline hero-portada__desktop-only">
                            {t.hero.tagline}
                        </h2>
                        <p class="bio hero-bio">
                            <span class="hero-bio__text">
                                {t.hero.bioStart}<span class="highlight hero-bio__highlight"
                                    >{t.hero.learn}</span
                                >{t.hero.bioMid}<span class="highlight hero-bio__highlight"
                                    >{t.hero.apply}</span
                                >{t.hero.bioEnd}
                            </span>
                        </p>
                    </div>
                    <div class="hero-actions">
                        <a
                            href="/projects"
                            class="hero-cta hero-portada__mobile-only interactive-base focus-ring"
                        >
                            {t.hero.viewProjects}
                        </a>
                        <a
                            href="mailto:irecgc@gmail.com"
                            class="hero-cta hero-cta--contact hero-portada__desktop-only interactive-base focus-ring"
                        >
                            {t.hero.contact}
                        </a>
                        <div
                            id="socialTags"
                            class="hero-social relative flex flex-wrap gap-4 text-[#BABABA]"
                        >
                    <a
                        href="https://github.com/nairec"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${t.a11y.github} (${t.a11y.opensInNewTab})`}
                        class="interactive-base focus-ring rounded-sm"
                        ><svg
                            xmlns="http://www.w3.org/2000/svg"
                            id="git-logo"
                            class="link-icon"
                            fill="currentColor"
                            viewBox="0 0 256 256"
                            aria-hidden="true"
                            ><path
                                d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z"
                            ></path></svg
                        ></a
                    >
                    <a
                        href="https://linkedin.com/in/eric-garcia-cano"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${t.a11y.linkedin} (${t.a11y.opensInNewTab})`}
                        class="interactive-base focus-ring rounded-sm"
                        ><svg
                            xmlns="http://www.w3.org/2000/svg"
                            id="linkedIn-logo"
                            class="link-icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                            aria-hidden="true"
                            ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path><path d="M8 11v5"></path><path d="M8 8v.01"
                            ></path><path d="M12 16v-5"></path><path
                                d="M16 16v-3a2 2 0 1 0 -4 0"></path><path
                                d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                            ></path></svg
                        ></a
                    >
                    <a
                        href="https://x.com/PyNair"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${t.a11y.x} (${t.a11y.opensInNewTab})`}
                        class="interactive-base focus-ring rounded-sm"
                        ><svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="link-icon"
                            id="twitter-logo"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="icon icon-tabler icons-tabler-outline icon-tabler-brand-x"
                            aria-hidden="true"
                            ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                            ></path><path
                                d="M4 4l11.733 16h4.267l-11.733 -16l-4.267 0"
                            ></path><path
                                d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"
                            ></path></svg
                        ></a
                    >
                </div>
                </div>
                </div>
            </section>
            <section id="chatbot-box" class="xl:flex hidden">
                <Chatbot
                    client:load
                    locale={locale}
                    placeholder={t.chat.placeholder}
                    sendAria={t.chat.sendAria}
                    greeting={t.chat.greeting}
                    errorMessage={t.chat.error}
                />
            </section>
        </div>
        <SectionDivider class="px-6" />
        <section
            id="works"
            class="mx-auto flex flex-col max-w-5xl w-full px-6 gap-16"
            aria-labelledby="works-header"
        >
            <h2
                id="works-header"
                class="scroll-reveal relative place-self-center md:place-self-start text-5xl text-muted tracking-tight"
                data-scroll-reveal
            >
                {t.works.heading}
            </h2>
            <div class="works-list">
                {
                    t.works.items.map((item, index) => (
                        <article
                            class:list={[
                                "work-block scroll-reveal",
                                index % 2 === 0
                                    ? "scroll-reveal--from-left"
                                    : "scroll-reveal--from-right",
                                index % 2 === 1 && "work-block--reverse",
                            ]}
                            data-scroll-reveal
                        >
                            <div class="work-header">
                                <div
                                    class="work-illustration"
                                    set:html={workIllustrations[index]}
                                    aria-hidden="true"
                                />
                                <div class="work-heading">
                                    <span class="work-number" aria-hidden="true">
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                    <h3 class="work-title">{item.title}</h3>
                                </div>
                            </div>
                            <p class="work-description">{item.description}</p>
                        </article>
                    ))
                }
            </div>
        </section>
        <SectionDivider class="px-6" />
        <section
            id="stack"
            class="mx-auto flex flex-col max-w-3xl w-full px-2 gap-16"
            aria-labelledby="stack-header"
        >
            <h2
                id="stack-header"
                class="scroll-reveal relative place-self-center md:place-self-end text-5xl text-muted tracking-tight"
                data-scroll-reveal
            >
                {t.stack.heading}
            </h2>
            <ul
                class="flex flex-col items-end text-end gap-7 text-white p-4 w-full"
            >
                <li class="scroll-reveal scroll-reveal--from-right flex flex-col gap-3" data-scroll-reveal>
                    <span>{t.stack.languages}</span>
                    <ul class="inline-flex gap-4 list-none p-0 m-0">
                        <li>
                            <Tag
                                name="python"
                                class="w-8 h-8 text-blue-500 drop-shadow-xl"
                            />
                        </li>
                        <li>
                            <Tag
                                name="javascript"
                                class="w-8 h-8 text-yellow-500"
                            />
                        </li>
                        <li>
                            <Tag
                                name="typescript"
                                class="w-8 h-8 text-blue-600 scale-170"
                            />
                        </li>
                        <li>
                            <Tag name="C" class="w-8 h-8 text-blue-500" />
                        </li>
                        <li>
                            <Tag name="java2" class="w-8 h-8 text-blue-500" />
                        </li>
                        <li>
                            <Tag
                                name="html2"
                                class="w-8 h-8 text-red-500 scale-120"
                            />
                        </li>
                        <li>
                            <Tag
                                name="css"
                                class="w-8 h-8 text-blue-700 scale-120"
                            />
                        </li>
                    </ul>
                </li>
                <li class="scroll-reveal scroll-reveal--from-right flex flex-col gap-3" data-scroll-reveal>
                    <span>{t.stack.frontend}</span>
                    <ul class="inline-flex gap-4 list-none p-0 m-0">
                        <li><Tag name="react" class="w-8 h-8 text-sky-500" /></li>
                        <li><Tag name="astroIcon" class="w-8 h-8 text-cyan-500" /></li>
                        <li><Tag name="nextjs" class="w-8 h-8 text-white-500" /></li>
                    </ul>
                </li>
                <li class="scroll-reveal scroll-reveal--from-right flex flex-col gap-3" data-scroll-reveal>
                    <span>{t.stack.backend}</span>
                    <ul class="inline-flex gap-4 list-none p-0 m-0">
                        <li><Tag name="nodejs" class="w-8 h-8 text-green-600" /></li>
                        <li><Tag name="mongodb" class="w-8 h-8 text-blue-500" /></li>
                        <li><Tag name="postman" class="w-8 h-8 text-orange-500" /></li>
                        <li><Tag name="fastapi" class="w-8 h-8 text-green-700" /></li>
                    </ul>
                </li>
                <li class="scroll-reveal scroll-reveal--from-right flex flex-col gap-3" data-scroll-reveal>
                    <span>{t.stack.devops}</span>
                    <ul class="inline-flex gap-4 list-none p-0 m-0">
                        <li><Tag name="git" class="w-8 h-8 text-orange-600" /></li>
                        <li><Tag name="docker" class="w-8 h-8 text-blue-800" /></li>
                    </ul>
                </li>
                <li class="scroll-reveal scroll-reveal--from-right flex flex-col gap-3" data-scroll-reveal>
                    <span>{t.stack.cloud}</span>
                    <ul class="inline-flex gap-4 list-none p-0 m-0">
                        <li><Tag name="vercel" class="w-16 h-16 text-white-500" /></li>
                        <li><Tag name="heroku" class="w-8 h-8 text-purple-600" /></li>
                        <li><Tag name="digitalocean" class="w-8 h-8 text-blue-500" /></li>
                    </ul>
                </li>
            </ul>
        </section>
    </main>
</div>

<style>
    #container {
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        overflow-y: hidden;
    }

    main {
        display: flex;
        flex-direction: column;
        justify-content: start;
        align-items: center;
        gap: 6rem;
        padding-bottom: 50px;
    }

    @media (min-width: 768px) {
        main {
            gap: 8rem;
        }
    }

    .hero-layout {
        width: 100%;
    }

    @media (max-width: 1279px) {
        .hero-layout {
            max-width: none;
        }
    }

    #hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        min-height: 100dvh;
        padding: 0;
        gap: 0;
        align-items: stretch;
    }

    .hero-portada__band {
        margin: 0;
        min-height: 100dvh;
        height: 100dvh;
        overflow: hidden;
    }

    .hero-portada__band img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        image-rendering: pixelated;
    }

    .hero-portada__panel {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 1.75rem;
        min-height: 100dvh;
        padding: max(1rem, env(safe-area-inset-top)) 1.35rem 2rem 1rem;
        overflow-y: auto;
    }

    .hero-portada__copy {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .hero-portada__desktop-only {
        display: none;
    }

    .hero-portada__mobile-only {
        display: inline-block;
    }

    .hero-name {
        margin: 0;
        font-family: "Cormorant Variable", "Times New Roman", serif;
        font-weight: 300;
        font-size: clamp(2.1rem, 10vw, 2.85rem);
        line-height: 0.98;
        letter-spacing: -0.03em;
        color: #f4f4f5;
    }

    .hero-bio {
        margin: 0;
        max-width: 19ch;
    }

    .hero-bio__text {
        font-family: "plus-jakarta-sans", system-ui, sans-serif;
        font-weight: 300;
        font-size: 0.68rem;
        line-height: 1.75;
        color: #8f8f95;
        letter-spacing: 0.01em;
    }

    .hero-bio__highlight {
        color: inherit;
    }

    .hero-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.75rem;
        width: 100%;
    }

    .hero-cta {
        font-family: "plus-jakarta-sans", system-ui, sans-serif;
        font-size: 0.72rem;
        font-weight: 400;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #e4e4e7;
        text-decoration: none;
        padding-bottom: 0.2rem;
        border-bottom: 1px solid color-mix(in srgb, #e4e4e7 35%, transparent);
    }

    .hero-cta:hover {
        color: #ffffff;
        border-bottom-color: #ffffff;
    }

    .hero-social {
        gap: 1.1rem;
    }

    .hero-social .link-icon {
        width: 1.35rem;
        height: 1.35rem;
        color: #7a7a82;
    }

    .hero-social .link-icon:hover {
        color: #d4d4d8;
        filter: none;
    }

    .hero-social #git-logo:hover,
    .hero-social #linkedIn-logo:hover,
    .hero-social #twitter-logo:hover {
        color: #d4d4d8;
        filter: none;
    }

    @media (min-width: 768px) and (max-width: 1279px) {
        .hero-portada__panel {
            padding: max(1.25rem, env(safe-area-inset-top)) 2rem 2.5rem 1.5rem;
            gap: 2rem;
        }

        .hero-name {
            font-size: clamp(2.6rem, 7vw, 3.4rem);
        }

        .hero-bio__text {
            font-size: 0.76rem;
            max-width: 24ch;
        }
    }

    @media (min-width: 1280px) {
        #hero {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            width: auto;
            max-width: none;
            margin-left: 0;
            min-height: auto;
            gap: 2rem;
            padding: 16px;
        }

        .hero-portada__band {
            display: none;
        }

        .hero-portada__panel {
            min-height: auto;
            padding: 0;
            overflow: visible;
            gap: 2rem;
            justify-content: flex-start;
        }

        .hero-portada__desktop-only {
            display: block;
        }

        .hero-portada__mobile-only {
            display: none;
        }

        .hero-portada__copy {
            gap: 0.5rem;
        }

        .hero-name {
            font-family:
                "Cascadia Code", "Source Code Pro", Menlo, Consolas,
                "DejaVu Sans Mono", monospace;
            font-weight: 500;
            font-size: 3.75rem;
            line-height: 1;
            letter-spacing: 0;
            color: #41d3ff;
            margin: 0;
        }

        .hero-greeting {
            margin: 0;
            font-family:
                "Cascadia Code", "Source Code Pro", Menlo, Consolas,
                "DejaVu Sans Mono", monospace;
            font-size: 1rem;
            line-height: 1.35;
            color: #bababa;
        }

        .hero-tagline {
            font-size: 3rem;
            line-height: 1;
            margin: 0;
        }

        .hero-bio {
            font-size: 1em;
            line-height: 1.625;
            max-width: 65ch;
        }

        .hero-bio__text {
            font-family:
                "Cascadia Code", "Source Code Pro", Menlo, Consolas,
                "DejaVu Sans Mono", monospace;
            font-size: inherit;
            line-height: inherit;
            color: var(--color-bio);
            letter-spacing: 0;
        }

        .hero-bio__highlight {
            color: #41d3ff;
        }

        .hero-actions {
            gap: 1.5rem;
        }

        .hero-cta {
            font-family: inherit;
            font-size: 1.25rem;
            letter-spacing: 0;
            text-transform: none;
            color: #41d3ff;
            border: 1px solid color-mix(in srgb, #0891b2 40%, transparent);
            padding: 0.5rem;
        }

        .hero-cta--contact {
            display: inline-block;
        }

        .hero-social .link-icon {
            width: 2rem;
            height: 2rem;
        }
    }

    .name {
        font-family:
            "Cascadia Code", "Source Code Pro", Menlo, Consolas,
            "DejaVu Sans Mono", monospace;
        font-weight: 500;
        color: #41d3ff;
        margin: 0;
    }

    .title {
        font-family:
            "Cascadia Code", "Source Code Pro", Menlo, Consolas,
            "DejaVu Sans Mono", monospace;
        font-weight: 500;
        color: #bababa;
        margin: 0;
    }

    .bio {
        font-family:
            "Cascadia Code", "Source Code Pro", Menlo, Consolas,
            "DejaVu Sans Mono", monospace;
        color: var(--color-bio);
        margin: 0;
        font-size: 1em;
        margin-top: 2rem;
    }

    #socialTags::after {
        content: "";
        position: absolute;
        bottom: 1rem;
        left: 120%;
        display: block;
        width: 100%;
        height: 1px;
        background: #bababa;
    }

    .works-list {
        display: flex;
        flex-direction: column;
        gap: 4rem;
        width: 100%;
    }

    @media (min-width: 768px) {
        .works-list {
            gap: 5rem;
        }
    }

    .work-block {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 4rem;
        border-bottom: 1px solid color-mix(in srgb, #bababa 20%, transparent);
        font-family:
            "Cascadia Code", "Source Code Pro", Menlo, Consolas,
            "DejaVu Sans Mono", monospace;
    }

    .work-block:last-child {
        padding-bottom: 0;
        border-bottom: none;
    }

    .work-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .work-header {
            flex-direction: row;
            align-items: center;
            gap: 2.5rem;
        }

        .work-block--reverse .work-header {
            flex-direction: row-reverse;
        }
    }

    .work-illustration {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1 1 55%;
        min-width: 0;
        padding: 0.5rem;
    }

    .work-illustration :global(svg) {
        width: 100%;
        height: auto;
        max-height: 12rem;
    }

    @media (min-width: 768px) {
        .work-illustration :global(svg) {
            max-height: 14rem;
        }
    }

    .work-heading {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        flex: 1 1 45%;
        min-width: 0;
    }

    @media (max-width: 767px) {
        .work-header {
            align-items: stretch;
        }

        .work-heading {
            flex-direction: row;
            align-items: baseline;
            gap: 1rem;
            width: 100%;
        }

        .work-number {
            flex-shrink: 0;
            min-width: 2.25rem;
        }

        .work-title {
            text-align: left;
        }
    }

    @media (min-width: 768px) {
        .work-block--reverse .work-heading {
            align-items: flex-end;
            text-align: right;
        }
    }

    .work-number {
        font-size: 1.25rem;
        font-weight: 500;
        color: #41d3ff;
        line-height: 1;
    }

    @media (min-width: 768px) {
        .work-number {
            font-size: 1.5rem;
        }
    }

    .work-title {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.2;
        margin: 0;
    }

    @media (min-width: 768px) {
        .work-title {
            font-size: 1.75rem;
        }
    }

    .work-description {
        color: var(--color-bio);
        font-size: 1rem;
        line-height: 1.7;
        margin: 0;
        max-width: 65ch;
    }

    /*#stack-header::after {
        content: "";
        position: absolute;
        bottom: 1rem;
        right: 105%;
        display: block;
        width: 38rem;
        height: 1px;
        background: #bababa;
        }*/

    .box {
        padding: 16px;
        background: rgba(255, 255, 255, 1);
        border-radius: 16px;
        border: 1px solid white;
    }

    #bio {
        width: 0;
        min-width: 100%;
    }

    .highlight {
        color: #41d3ff;
    }

    .link-icon {
        width: 2rem;
        height: 2rem;
        transition:
            color var(--duration-base) var(--ease-out-smooth),
            filter var(--duration-base) var(--ease-out-smooth);
    }

    #git-logo:hover {
        color: rgb(188, 82, 238);
        filter: drop-shadow(2px 4px 2px rgb(131, 57, 165));
    }

    #linkedIn-logo:hover {
        color: rgb(10, 102, 194);
        filter: drop-shadow(2px 4px 2px rgb(7, 75, 143));
    }

    #twitter-logo:hover {
        color: rgb(29, 161, 242);
        filter: drop-shadow(2px 4px 2px rgb(19, 107, 161));
    }

    #email-logo:hover {
        color: rgb(172, 42, 19);
        filter: drop-shadow(1px 1px 2px rgb(172, 42, 19));
    }

    @media screen and (max-width: 1279px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #socialTags::after {
            display: none;
        }

        .link-icon {
            width: 1.75rem;
            height: 1.75rem;
        }
    }
</style>

<script>
    function initHomeScreenNav() {
        if (!document.body.classList.contains("is-home-screen")) return;

        const mq = window.matchMedia("(max-width: 1279px)");
        const update = () => {
            if (!mq.matches) {
                document.body.classList.remove("is-scrolled");
                return;
            }
            document.body.classList.toggle(
                "is-scrolled",
                window.scrollY > window.innerHeight * 0.35,
            );
        };

        update();
        window.addEventListener("scroll", update, { passive: true });
        mq.addEventListener("change", update);
    }

    initHomeScreenNav();
    document.addEventListener("astro:page-load", initHomeScreenNav);
</script>


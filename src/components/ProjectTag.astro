---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import eyeIcon from "../assets/SVGs/eye-icon.svg?raw";
import { getTranslations } from "../i18n";

export interface Props {
    name: string;
    desc: string;
    link: string;
    imgPath: string;
    stack: string[];
    year: number;
    imgObjectPosition?: string;
}

const { name, desc, link, imgPath, stack, year, imgObjectPosition } =
    Astro.props;
const t = getTranslations(Astro.locals.locale);
const linkLabel = `${name} (${t.a11y.opensInNewTab})`;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/projectImages/*.{jpg,png,jpeg}",
    { eager: true },
);
if (!images[imgPath])
    throw new Error(
        `"${imgPath}" does not exist in glob: "/src/assets/projectImages/*.{jpeg,jpg,png}"`,
    );
---

<a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={linkLabel}
    class="project-card group flex flex-col gap-5 p-5 border-2 border-gray-600 backdrop-blur-lg
        w-full h-full interactive-base
        hover:border-cyan-400/40 hover:shadow-[0_0_24px_-8px_rgba(65,211,255,0.15)]
        focus-ring rounded-sm"
>
    <div class="flex flex-row items-center justify-between gap-3">
        <span
            class="text-xl font-semibold text-accent w-fit relative project-card-title"
        >
            {name}
        </span>
        <div class="flex items-center gap-2 shrink-0">
            <span class="text-xs font-mono text-gray-500 translate-y-[3px]">{year}</span>
            <span
                class="project-card-eye"
                aria-hidden="true"
                set:html={eyeIcon}
            />
        </div>
    </div>

    <div
        class="aspect-video overflow-hidden rounded-sm ring-2 ring-gray-700 shadow-[0_8px_10px_-4px_rgba(0,0,0,0.8)]"
    >
        <Image
            src={images[imgPath].default}
            alt={name}
            transition:animate="none"
            class:list={[
                "w-full h-full object-cover select-none transition-transform duration-500 group-hover:scale-[1.02]",
                !imgObjectPosition && "object-top",
            ]}
            style={
                imgObjectPosition
                    ? { objectPosition: imgObjectPosition }
                    : undefined
            }
        />
    </div>

    <div class="project-desc-wrap">
        <p class="project-desc text-gray-200 text-sm leading-relaxed line-clamp-3">
            {desc}
        </p>
        <span class="project-desc-tip" role="tooltip" aria-hidden="true">{desc}</span>
    </div>

    <div class="flex flex-row gap-2 flex-wrap mt-auto">
        {
            stack.map((tag) => (
                <span class="px-2 py-0.5 text-xs font-mono text-cyan-300/90 border border-cyan-600/25 rounded-sm">
                    {tag}
                </span>
            ))
        }
    </div>
</a>

<style>
    .project-card:hover {
        transform: scale(1.01);
    }

    .project-card:has(.project-desc-wrap[data-truncated]:hover) {
        position: relative;
        z-index: 10;
    }

    .project-card-title {
        transition:
            color var(--duration-base) var(--ease-out-smooth),
            transform var(--duration-base) var(--ease-out-smooth);
    }

    .project-card:hover .project-card-title {
        color: var(--color-accent-hover);
        transform: translateX(12px);
    }

    .project-card-title::before {
        content: ">";
        position: absolute;
        left: 0;
        opacity: 0;
        transition:
            opacity var(--duration-fast) var(--ease-out-smooth),
            transform var(--duration-base) var(--ease-out-smooth);
    }

    .project-card:hover .project-card-title::before {
        opacity: 1;
        transform: translateX(-12px);
    }

    .project-card-eye {
        display: inline-flex;
        width: 1rem;
        height: 1rem;
        color: var(--color-accent);
        opacity: 0;
        transform: scale(0.85);
        filter: drop-shadow(0 0 0 transparent);
        transition:
            opacity var(--duration-base) var(--ease-out-smooth),
            color var(--duration-base) var(--ease-out-smooth),
            transform var(--duration-base) var(--ease-out-smooth),
            filter var(--duration-base) var(--ease-out-smooth);
    }

    .project-card-eye :global(svg) {
        width: 100%;
        height: 100%;
    }

    .project-card:hover .project-card-eye {
        opacity: 1;
        transform: scale(1);
        color: var(--color-accent-hover);
        filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-accent) 45%, transparent));
    }

    .project-desc-wrap {
        position: relative;
    }

    .project-desc-wrap[data-truncated] {
        cursor: help;
    }

    .project-desc-tip {
        position: absolute;
        left: 0;
        right: 0;
        bottom: calc(100% + 0.4rem);
        z-index: 20;
        padding: 0.55rem 0.7rem;
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--color-bio);
        background: color-mix(in srgb, #050505 88%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-surface-border) 70%, transparent);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 20px -12px rgba(0, 0, 0, 0.75);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(4px);
        transition:
            opacity var(--duration-fast) var(--ease-out-smooth),
            transform var(--duration-fast) var(--ease-out-smooth),
            visibility var(--duration-fast) var(--ease-out-smooth);
    }

    .project-desc-wrap[data-truncated]:hover .project-desc-tip {
        opacity: 1;
        visibility: visible;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .project-card:hover {
            transform: none;
        }

        .project-card:hover .project-card-title {
            transform: none;
        }

        .project-desc-tip {
            transform: none;
        }
    }
</style>

<script>
    function bindDescTips() {
        document.querySelectorAll(".project-desc-wrap").forEach((wrap) => {
            if (!(wrap instanceof HTMLElement) || wrap.dataset.tipBound) return;
            wrap.dataset.tipBound = "true";
            wrap.addEventListener("pointerenter", () => {
                const p = wrap.querySelector(".project-desc");
                if (!(p instanceof HTMLElement)) return;
                wrap.toggleAttribute(
                    "data-truncated",
                    p.scrollHeight > p.clientHeight + 1,
                );
            });
        });
    }

    document.addEventListener("astro:page-load", bindDescTips);
</script>
